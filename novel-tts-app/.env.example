# AI Provider
TTS_API_KEY=
TTS_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1

# LLM 模型（主用 M3 Pro）
LLM_MODEL_PRO=MiniMax-M3
LLM_MODEL_FAST=MiniMax-M2.7-highspeed

# Server
BIND_HOST=127.0.0.1
PORT=8000

# Paths
DATA_DIR=./data
AUDIO_DIR=./data/audio
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Timeouts (秒)
LLM_TIMEOUT=600
TTS_TIMEOUT=600
UVICORN_TIMEOUT=600

# LLM 限流：同时最多 N 个请求在飞。
# 业务层（章节角色识别 / 每章对白归属）可能用 asyncio.gather 并发，
# 这里在 provider 层强制串行/限流，避免按量套餐 RPM 触发 429。
# - 1 = 串行（最稳，按量套餐推荐）
# - 2~3 = 轻度并发（套餐 RPM 宽松时可用，识别会快一些）
LLM_MAX_CONCURRENCY=1

# 角色识别采样上限（字符，中文=1字）：
# - 整本字数 <= 此值：逐 50k 切片跑角色识别 + 合并去重（准确、LLM 调用多）
# - 整本字数 >  此值：只抽前 N 字跑一次角色识别
#   500k = 50 万字，长篇小说前 50 万字已出场几乎全部主要角色；
#   2000 章小说从 40 次 LLM 降为 1 次。
LLM_CHAR_EXTRACT_LIMIT=500000

# TTS 并发限流（全局，所有 worker 共享同一计数器）
# 防止多任务同时合成时叠加并发爆 TTS 供应商 RPM 限制。
TTS_MAX_CONCURRENCY=4

# Auth (JWT) - 生产环境务必修改 JWT_SECRET
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXP_DAYS=7
# 启动时自动创建的默认管理员账号（已存在则跳过、不覆盖密码）
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=admin
# 测试/本地调试用：DISABLE_AUTH=true 时所有 /api/* 不校验 token
DISABLE_AUTH=false
