{
  "name": "dsh-audio-book-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：小布有声书创作编排（书库检索 / 创作任务 / 构建状态 / 成本流水），通过 /api/agent/* 调本机 audio-book 后端",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "skills",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
