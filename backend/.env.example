# ============================================================
# AI 有声小说生成 Web 应用 — 后端启动必需配置
# ============================================================
# 字段分组：
#   A. 启动必需（必须留 .env / 容器 env 注入）
#   B. 运行时可调（已迁出到页面「/api/settings」/「/api/providers」配置）
#
# A 区 = 必须在 .env 里提供的项（启动前需要）：
#   - DATA_DIR / AUDIO_DIR / DATABASE_URL  — 建库建目录
#   - BIND_HOST / PORT                      — uvicorn 监听
#   - JWT_SECRET / JWT_ALGORITHM            — JWT 签名（启动必须，敏感）
#   - SEED_ADMIN_USER / SEED_ADMIN_PASS     — 首次启动管理员账号
#   - DISABLE_AUTH / STRICT_PROD_SECURITY   — 安全开关（不走页面）
#   - ENV                                    — 控制启动 init 行为
#   - LOG_FILE / LOG_MAX_BYTES / LOG_BACKUP_COUNT — 日志基础设施（启动需默认路径）
#
# B 区 = 已迁出到页面的运行时参数（请在「/api/settings」和「/api/providers」中配置）：
#   - 厂商 API Key / Base URL / 模型选择     → /api/providers
#   - 豆包 TTS / ICL / Seed-Audio 凭据       → /api/providers（doubao 厂商卡片）
#   - 豆包运行参数（USE_V3 / RPM / 轮询 / 采样率 / 响度）→ /api/settings「豆包配置」
#   - 限流 / 缓存 / 切章 / 合成质量           → /api/settings
#   - 日志级别                                → /api/settings
#   - JWT 过期天数                            → /api/settings
#   - MULTICAST_STRICT_MODE                   → /api/settings
#
# ⚠️ 部署必改：
#   - JWT_SECRET   用一个长随机字符串（至少 32 字节）
#   - SEED_ADMIN_PASS  用强密码；首次登录后请立即改
# ============================================================

# ============ A. 启动必需 ============
DATA_DIR=./data
AUDIO_DIR=./data/audio
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
BIND_HOST=127.0.0.1
PORT=28000

# JWT 鉴权（启动时即用，绝不暴露给页面）
# ⚠️ 部署前必改：换成 32+ 字节随机字符串
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256

# 首次启动管理员账号（seed 时使用，登录后请到「设置 → 改密」改掉）
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=admin

# 安全开关（不走页面配置）
DISABLE_AUTH=false
STRICT_PROD_SECURITY=false
ENV=dev

# 日志基础设施（启动即落盘；级别 / 路径可后续走页面微调）
LOG_FILE=./data/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
