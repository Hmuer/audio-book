TTS_API_KEY=
TTS_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL_PRO=MiniMax-M3
# 强烈建议用 M3 而不是 M2.7-highspeed：M2.x 的 thinking 无法关闭，
# 在长上下文（多章批量对白归属）时容易陷入 thinking 循环耗尽 max_tokens
# 导致 600s ReadTimeout；M3 可通过 thinking:{type:disabled} 真正关闭 thinking，反而更快更稳。
LLM_MODEL_FAST=MiniMax-M3
BIND_HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
AUDIO_DIR=./data/audio
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
LLM_TIMEOUT=600
TTS_TIMEOUT=600
UVICORN_TIMEOUT=600
